# Clinicia — 20 dış API adaptör anahtarları (boş bırakılırsa mock modda çalışır)
PORT=8080

# 1. videoAdapter — Agora.io / Daily.co
VIDEO_PROVIDER=daily
DAILY_API_KEY=
AGORA_APP_ID=
AGORA_TOKEN=

# 2. aiAdapter — OpenAI GPT-4o / Anthropic Claude
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 3. chatAdapter — Twilio / Infobip WhatsApp Business
CHAT_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=api.infobip.com
INFOBIP_WHATSAPP_FROM=

# 4. ocrAdapter — Google Vision / AWS Textract
OCR_PROVIDER=gvision
GOOGLE_VISION_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 5. flightAdapter — FlightAware / Amadeus
FLIGHT_PROVIDER=flightaware
FLIGHTAWARE_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# 6. paymentAdapter — Stripe Connect / iZico
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
IZICO_API_KEY=

# 7. signatureAdapter — DocuSign / Dropbox Sign
SIGNATURE_PROVIDER=docusign
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_ACCOUNT_ID=
DROPBOX_SIGN_API_KEY=

# 8. hbysAdapter — BulutKlinik / Google Calendar
HBYS_PROVIDER=bulutklinik
BULUTKLINIK_API_KEY=
BULUTKLINIK_BASE_URL=https://api.bulutklinik.com
GOOGLE_CALENDAR_KEY=

# 9. geoAdapter — Google Maps / Mapbox
GEO_PROVIDER=gmaps
GOOGLE_MAPS_KEY=
MAPBOX_TOKEN=

# 10. mailAdapter — SendGrid / Resend
MAIL_PROVIDER=sendgrid
MAIL_FROM=noreply@clinicia.com.tr
SENDGRID_API_KEY=
RESEND_API_KEY=

# 11. insuranceAdapter — Allianz / Demir Sağlık
INSURANCE_PROVIDER=allianz
ALLIANZ_API_KEY=
DEMIR_API_KEY=

# 12. visaAdapter — Sherpa / e-Visa / USHAŞ
VISA_PROVIDER=sherpa
SHERPA_API_KEY=
EVISA_API_KEY=
USHAS_WEBHOOK_SECRET=

# 13. invoiceAdapter — Paraşüt / Sovos Foriba
INVOICE_PROVIDER=sovos
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
SOVOS_API_KEY=

# 14. fxAdapter — TCMB EVDS / ExchangeRate-API
FX_PROVIDER=tcmb
TCMB_EVDS_API_KEY=
EXCHANGERATE_API_KEY=

# 15. marketingAdapter — Meta CAPI / Google Ads / Make
MARKETING_PROVIDER=meta
META_CAPI_TOKEN=
GOOGLE_ADS_TOKEN=
MAKE_WEBHOOK_URL=

# 16. pacsAdapter — Orthanc / Ambra
PACS_PROVIDER=orthanc
ORTHANC_URL=
AMBRA_API_KEY=

# 17. geofenceAdapter — Radar.io / OneSignal
GEOFENCE_PROVIDER=radar
RADAR_SECRET_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# 18. localizationAdapter — DeepL / Lokalise
LOCALIZATION_PROVIDER=deepl
DEEPL_API_KEY=
LOKALISE_TOKEN=

# 19. analyticsAdapter — QuickSight / Tremor
ANALYTICS_PROVIDER=quicksight
AWS_QUICKSIGHT_ARN=
AWS_ACCOUNT_ID=
TREMOR_API_KEY=

# 20. socialDmAdapter — ManyChat / Respond.io
SOCIALDM_PROVIDER=manychat
MANYCHAT_API_KEY=
RESPOND_IO_TOKEN=
